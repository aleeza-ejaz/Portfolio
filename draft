/* ── Cloud page ── 
.cloud-section { padding: var(--section-pad) var(--page-margin); }

.cloud-inner { max-width: 1300px; margin: 0 auto; }

.cloud-list { display: flex; flex-direction: column; gap: 10px; }

.cloud-entry {
  display: flex;
  align-items: flex-start;
  gap: 1rem;
  padding: 1rem 1.25rem;
  border: 0.5px solid rgba(0,0,0,0.07);
  border-radius: var(--radius-md);
  cursor: var(--cursor);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
  max-width: 1300px;
}

.cloud-entry.orange {background: linear-gradient(90deg, var(--black) 64%, var(--orange) 100%);}
.cloud-entry.pink {background: linear-gradient(90deg, var(--black) 64%, var(--pink) 100%);}
.cloud-entry.blue {background: linear-gradient(90deg, var(--black) 64%, var(--blue) 100%);}

.cloud-entry:hover {
  transform: translateX(5px);
  box-shadow: 0 4px 20px rgba(141,121,255,0.1);
}

.cloud-entry-info { flex: 1; min-width: 0; }

.cloud-entry-type {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.1em;
  color: var(--purple);
  text-transform: uppercase;
  display: block;
  margin-bottom: 3px;
}

.cloud-entry-title {
  font-family: var(--font-display);
  font-size: 1.1rem;
  color: var(--white);
  margin-bottom: 3px;
}

.cloud-entry-desc {
  font-size: 0.85rem;
  color: var(--white) rgba(255,255,255,0.45);
  line-height: 1.5;
  margin-bottom: 8px;
}

.cloud-entry-tags { display: flex; gap: 4px; flex-wrap: wrap; }

.cloud-entry-arrow {
  font-size: 1rem;
  color: var(--white);
  align-self: center;
  flex-shrink: 0;
  transition: transform 0.2s, color 0.2s;
}
.cloud-entry:hover .cloud-entry-arrow {
  transform: translateX(4px);
  color: var(--black);
}

/* Cloud detail view 
.cloud-detail-section { padding: var(--section-pad) var(--page-margin); }

.back-btn {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.08em;
  color: var(--black);
  background: none;
  border: none;
  cursor: var(--cursor);
  padding: 0;
  margin-bottom: 2rem;
  display: flex;
  align-items: center;
  gap: 6px;
  transition: color 0.2s;
}
.back-btn:hover { color: var(--purple); }

.cloud-detail {
  width: 100%;
  background: var(--black);
  border-radius: var(--radius-lg);
  overflow: hidden;
  border: 0.5px solid rgba(0,0,0,0.07);
}

.cloud-detail-header {
  padding: 2.5rem 2.5rem 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.cloud-detail-title {
  font-family: var(--font-display);
  font-size: clamp(1.75rem, 3.5vw, 2.5rem);
  color: var(--white);
}

.cloud-detail-tags { display: flex; gap: 6px; flex-wrap: wrap; }

.cloud-detail-divider {
  border: none;
  border-top: 1px solid rgba(0,0,0,0.07);
  margin: 0 2.5rem;
}

.cloud-detail-body {
  padding: 1.75rem 2.5rem 2.5rem;
  display: flex;
  flex-direction: column;
  gap: 2rem;
}

.cloud-section {}

.cloud-section-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  margin-bottom: 0.65rem;
  display: flex;
  align-items: center;
  gap: 8px;
}

.cloud-section-label.purple { color: var(--purple);}
.cloud-section-label.pink { color: var(--pink);}
.cloud-section-label.blue { color: var(--blue);}
.cloud-section-label.orange { color: var(--orange);}

.cloud-section-label::after {
  content: '';
  flex: 1;
  height: 1px;
  background: rgba(141,121,255,0.15);
}

.cloud-section-text {
  font-size: 0.95rem;
  color: rgba(0,0,0,0.6);
  line-height: 1.85;
}

.code-block {
  background: #0a0a0a;
  border-radius: 12px;
  padding: 1rem 1.25rem;
  margin-top: 0.75rem;
  overflow-x: auto;
}

.code-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: rgba(255,255,255,0.3);
  letter-spacing: 0.08em;
  margin-bottom: 8px;
}

.code-block pre {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  color: #e2e8f0;
  line-height: 1.75;
  white-space: pre;
}

.code-block code {
  font-family: inherit;
  font-size: inherit;
  background: none;
  color: inherit;
  padding: 0;
  border-radius: 0;
}

.cloud-outcome-box {
  background: rgba(141,121,255,0.06);
  border: 1px solid rgba(141,121,255,0.16);
  border-radius: 12px;
  padding: 1rem 1.25rem;
}
.cloud-outcome-box p {
  font-size: 0.95rem;
  color: rgba(0,0,0,0.6);
  line-height: 1.8;
}

.cloud-detail-links { display: flex; gap: 10px; flex-wrap: wrap; padding-top: 0.5rem; }

.cloud-link {
  font-family: var(--font-mono);
  font-size: 0.78rem;
  letter-spacing: 0.05em;
  padding: 8px 16px;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(0,0,0,0.12);
  color: rgba(0,0,0,0.5);
  transition: all 0.2s;
}
.cloud-link:hover { border-color: var(--purple); color: var(--purple); background: rgba(141,121,255,0.07); }

.cloud-link--primary {
  background: var(--black);
  color: var(--white);
  border-color: var(--black);
}
.cloud-link--primary:hover { background: #1a0050; border-color: var(--purple); color: var(--white); }

